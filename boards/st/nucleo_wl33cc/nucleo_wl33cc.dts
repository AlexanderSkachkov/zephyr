/dts-v1/;
#include <st/wl3/stm32wl33Xc.dtsi>
#include <st/wl3/stm32wl33ccvx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include "arduino_r3_connector.dtsi"

/ {
	model = "STMicroelectronics STM32WL33CC1-NUCLEO board";
	compatible = "st,stm32wl33cc-nucleo";

	#address-cells = <1>;
	#size-cells = <1>;

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,entropy = &rng;
	};

	mrsubg_radio: radio@49000000 {
		status = "okay";
		compatible = "st,mrsubg";
        reg = <0x49000000 DT_SIZE_K(2)>;
	};

	leds: leds {
		compatible = "gpio-leds";

		blue_led_1: led_0 {
			gpios = <&gpioa 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		green_led_1: led_1 {
			gpios = <&gpiob 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};

		red_led_1: led_2 {
			gpios = <&gpiob 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		};
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";
		status = "okay";

		pwm_red_led_1: pwm_led_1 {
			pwms = <&pwm1 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button_1: button_0 {
			label = "SW1";
			gpios = <&gpioa 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		user_button_2: button_1 {
			label = "SW2";
			gpios = <&gpioa 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_1>;
		};

		user_button_3: button_2 {
			label = "SW3";
			gpios = <&gpiob 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_2>;
		};
	};

	aliases {
		rtc = &rtc;
		led0 = &blue_led_1;
		led1 = &green_led_1;
		led2 = &red_led_1;
		pwm-led0 = &pwm_red_led_1;
		sw0 = &user_button_1;
		sw1 = &user_button_2;
		sw2 = &user_button_3;
		watchdog0 = &iwdg;
	};
};

&pwrc {
	smps-mode = "RUN";
	smps-bom = <1>;
	smps-output-voltage = "1V40";
};

&clk_lse {
	status = "okay";
};

// &clk_lsi {
// 	status = "okay";
// };

&clk_hse {
	status = "okay";
};

&clk_hsi {
	status = "okay";
};

&pll {
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(48)>;
	clksys-prescaler = <1>;
	slow-clock = <&clk_lse>;
	// slow-clock = <&clk_lsi>;
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB0, 12)>,
		 <&rcc STM32_SRC_LSE NO_SEL>;
	status = "okay";
};

&iwdg {
	status = "okay";
};

&radio_timer {
	status = "okay";
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa1 &usart1_rx_pa15>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&lpuart1 {
	pinctrl-0 = <&lpuart1_tx_pb6 &lpuart1_rx_pb7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	status = "okay";
};

&spi3 {
	pinctrl-0 = <&spi3_nss_pa9 &spi3_sck_pa3 &spi3_miso_pa8 &spi3_mosi_pa11>;
	pinctrl-names = "default";
	status = "okay";
	/* Select 64MHz clock for SPI3 */
	clocks = <&rcc STM32_CLOCK(APB1, 14)>,
		 <&rcc STM32_SRC_SYSCLK SPI3_I2S_SEL(3)>;
};

&timers2 {
	status = "okay";
	st,prescaler = <10000>;
	pwm1: pwm {
		// STM32WL3 series supports only one PWM output in the HAL drivers
		pinctrl-0 = <&tim2_ch1_pa4>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&rng {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Set 8KB of storage at the end of 192KB flash */
		storage_partition: partition@3e000 {
			label = "storage";
			reg = <0x0003e000 DT_SIZE_K(8)>;
		};
	};
};
