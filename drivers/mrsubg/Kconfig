config MRSUBG_STM32WL3
	bool "STM32WL3 SubGhz driver"
	default y
	depends on DT_HAS_ST_MRSUBG_ENABLED
	select HAS_STM32LIB
	select USE_STM32_HAL_PKA
	select USE_STM32_HAL_CORTEX
	select USE_STM32_HAL_GPIO
	select USE_STM32_HAL_RADIO
	select USE_STM32_HAL_RADIO_TIMER
	help
	  ST STM32WL3 SubGhz Radio interface